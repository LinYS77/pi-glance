{
  "name": "pi-glance",
  "version": "0.6.5",
  "description": "A calm input surface for Pi with a rounded multiline editor and adaptive status glance.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "input-surface",
    "statusline",
    "terminal",
    "tui"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "author": "linys77",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinYS77/pi-glance.git"
  },
  "homepage": "https://github.com/LinYS77/pi-glance#readme",
  "bugs": {
    "url": "https://github.com/LinYS77/pi-glance/issues"
  },
  "files": [
    "index.ts",
    "src/**/*.ts",
    "README*.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/LinYS77/pi-glance/main/assets/themes.gif"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build:dev": "rm -rf .tmp-test && tsc -p tsconfig.test.json",
    "test": "npm run test:dev",
    "test:boundaries": "npm run build:dev --silent && node .tmp-test/tests/test-boundaries.js",
    "test:command-save": "npm run build:dev --silent && node .tmp-test/tests/test-glance-command-save.js",
    "test:config": "npm run build:dev --silent && node .tmp-test/tests/test-config.js",
    "test:config-schema": "npm run build:dev --silent && node .tmp-test/tests/test-config-schema.js",
    "test:config-io": "npm run build:dev --silent && node .tmp-test/tests/test-config-io.js",
    "test:footer": "npm run build:dev --silent && node .tmp-test/tests/test-footer-facts.js",
    "test:runtime": "npm run build:dev --silent && node .tmp-test/tests/test-runtime.js",
    "test:runtime:refresh-session": "npm run build:dev --silent && node .tmp-test/tests/test-runtime-refresh-session.js",
    "test:session-start": "npm run build:dev --silent && node .tmp-test/tests/test-session-start-order.js",
    "test:state-inputs": "npm run build:dev --silent && node .tmp-test/tests/test-state-inputs.js",
    "test:status-line": "npm run build:dev --silent && node .tmp-test/tests/test-status-line.js",
    "test:throughput": "npm run build:dev --silent && node .tmp-test/tests/test-throughput.js && node .tmp-test/tests/test-throughput-run-tracker.js && node .tmp-test/tests/test-state-throughput.js && node .tmp-test/tests/test-runtime-throughput.js && node .tmp-test/tests/test-throughput-status-line.js && node .tmp-test/tests/test-throughput-config.js && node .tmp-test/tests/test-throughput-settings.js && node .tmp-test/tests/test-throughput-boundaries.js && node .tmp-test/tests/test-throughput-readme.js",
    "test:dev": "npm run build:dev --silent && node --test --test-concurrency=4 .tmp-test/tests/test-*.js",
    "test:git": "npm run build:dev --silent && node .tmp-test/tests/test-git.js && node .tmp-test/tests/test-git-refresher.js && node .tmp-test/tests/test-state-git.js && node .tmp-test/tests/test-render-git.js",
    "test:catalog": "npm run build:dev --silent && node .tmp-test/tests/test-settings-catalog.js",
    "test:registry": "npm run build:dev --silent && node .tmp-test/tests/test-segment-registry.js",
    "test:readme": "npm run build:dev --silent && node .tmp-test/tests/test-readme.js",
    "test:pane:model": "npm run build:dev --silent && node .tmp-test/tests/test-pane-model.js",
    "test:pane": "npm run build:dev --silent && node .tmp-test/tests/test-pane-model.js && node .tmp-test/tests/test-pane-render.js",
    "debug:git": "npm run build:dev --silent && node .tmp-test/scripts/debug-git.js",
    "pack:dry": "npm pack --dry-run"
  }
}
